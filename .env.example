# Copiar a .env y completar. Nunca subir .env al repositorio.
POSTGRES_DB=planbot
POSTGRES_USER=owner_planbot
POSTGRES_PASSWORD=cambiar
BOT_CARGA_PASSWORD=cambiar
WEB_LECTURA_PASSWORD=cambiar
PGRST_JWT_SECRET=cambiar_por_un_secreto_de_32_caracteres_o_mas
# Conexión PostgreSQL nativo (scripts y Blue Prism). Por defecto localhost, 5432 y la ruta de abajo.
PG_HOST=localhost
PG_PORT=5432
PG_BIN=C:\Program Files\PostgreSQL\16\bin
# Solo para scripts\instalar_sin_docker.ps1 (superusuario del PostgreSQL nativo)
PG_SUPER_USER=postgres
PG_SUPER_PASSWORD=cambiar
